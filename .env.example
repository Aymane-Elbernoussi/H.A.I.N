# Copy to .env and fill in. Never commit .env.

# BAND — one UUID + API key per agent, created at https://app.band.ai
TRIAGE_AGENT_ID=
TRIAGE_API_KEY=
COMMS_AGENT_ID=
COMMS_API_KEY=
LEDGER_AGENT_ID=
LEDGER_API_KEY=
POLICY_AGENT_ID=
POLICY_API_KEY=
# BAND_REST_URL / BAND_WS_URL default to Band Cloud; override only for self-hosted.

# LLM provider for the agents (BAND adapters)
OPENAI_API_KEY=

# Kylon workspace
KYLON_API_KEY=
KYLON_WORKSPACE_ID=

# Rocket Ride Cloud (promo code from hackathon Discord)
ROCKETRIDE_API_KEY=

# Prelint — connect the GitHub repo at https://prelint.com
PRELINT_API_KEY=
